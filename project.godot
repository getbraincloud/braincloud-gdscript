; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes in []
;   param=value ; assignment
;
; Only set parameters that differ from the engine defaults,
; save to preserve defaults.

config_version=5

[application]

config/name="BrainCloud GDScript SDK"
config/description="brainCloud client SDK for GDScript / Godot 4"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/braincloud/plugin.cfg")
