@tool
class_name BrainCloudBuildProfile
extends RefCounted

# The project's build value: 32 random bytes in res://.braincloud/build_profile.gd, a dot-folder
# Godot neither imports nor exports. braincloud.cfg only reads with it; the export plugin copies
# it into the exported main scene.

const PATH := "res://.braincloud/build_profile.gd"
const LENGTH := 32

static func new_value() -> PackedByteArray:
	return Crypto.new().generate_random_bytes(LENGTH)

# Parts for value[i] = t0[t3[i]] ^ t1[i] ^ t2[(i * k) & 31], random per call.
static func _split(value: PackedByteArray) -> Dictionary:
	var crypto := Crypto.new()
	var t3 := PackedByteArray()
	for i in LENGTH:
		t3.append(i)
	var r := crypto.generate_random_bytes(LENGTH + 1)
	for i in range(LENGTH - 1, 0, -1):
		var j := r[i] % (i + 1)
		var tmp := t3[i]
		t3[i] = t3[j]
		t3[j] = tmp
	var k := (r[LENGTH] % 16) * 2 + 1
	var t1 := crypto.generate_random_bytes(LENGTH)
	var t2 := crypto.generate_random_bytes(LENGTH)
	var t0 := PackedByteArray()
	t0.resize(LENGTH)
	for i in LENGTH:
		t0[t3[i]] = value[i] ^ t1[i] ^ t2[(i * k) & 31]
	return {"t0": t0, "t1": t1, "t2": t2, "t3": t3, "k": k}

static func source(value: PackedByteArray) -> String:
	var p := _split(value)
	var out := "# Generated by brainCloud. Keep it with braincloud.cfg and out of public source control.\n"
	out += "extends RefCounted\n\n"
	out += _array("t0", p["t0"]) + _array("t1", p["t1"]) + _array("t2", p["t2"]) + _array("t3", p["t3"]) + "\n"
	out += "static func value() -> PackedByteArray:\n"
	out += "\tvar out := PackedByteArray()\n"
	out += "\tout.resize(32)\n"
	out += "\tfor i in 32:\n"
	out += "\t\tout[i] = t0[t3[i]] ^ t1[i] ^ t2[(i * %d) & 31]\n" % p["k"]
	out += "\treturn out\n"
	return out

# Export copy: t0 | t1 | t2 | t3 | k, split afresh (read by BrainCloudWrapper._build_value).
static func pack(value: PackedByteArray) -> PackedByteArray:
	var p := _split(value)
	var out: PackedByteArray = p["t0"] + p["t1"] + p["t2"] + p["t3"]
	out.append(p["k"])
	return out

static func write(value: PackedByteArray) -> bool:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(PATH.get_base_dir()))
	var f := FileAccess.open(PATH, FileAccess.WRITE)
	if f == null:
		return false
	f.store_string(source(value))
	f.close()
	return true

# The project's value (or `path`'s); empty if missing/invalid.
static func read(path: String = PATH) -> PackedByteArray:
	if not FileAccess.file_exists(path):
		return PackedByteArray()
	return parse(FileAccess.get_file_as_string(path))

static func parse(text: String) -> PackedByteArray:
	var parts := []
	for name in ["t0", "t1", "t2", "t3"]:
		var part := _parse_array(text, name)
		if part.size() != LENGTH:
			return PackedByteArray()
		parts.append(part)
	var m := RegEx.create_from_string("\\(i \\* (\\d+)\\) & 31").search(text)
	if m == null:
		return PackedByteArray()
	var k := int(m.get_string(1))
	var value := PackedByteArray()
	value.resize(LENGTH)
	for i in LENGTH:
		if parts[3][i] >= LENGTH:
			return PackedByteArray()
		value[i] = parts[0][parts[3][i]] ^ parts[1][i] ^ parts[2][(i * k) & 31]
	return value

static func hex(value: PackedByteArray) -> String:
	return value.hex_encode()

# 64 hex characters (spaces/colons allowed); empty if invalid.
static func parse_hex(text: String) -> PackedByteArray:
	var clean := ""
	for c in text:
		if c in " :\t\r\n":
			continue
		if not c.is_valid_hex_number():
			return PackedByteArray()
		clean += c
	if clean.length() != LENGTH * 2:
		return PackedByteArray()
	return clean.hex_decode()

static func _array(name: String, bytes: PackedByteArray) -> String:
	var out := "const %s: PackedByteArray = [" % name
	for i in bytes.size():
		if i > 0:
			out += "," if i % 12 == 0 else ", "
		if i % 12 == 0:
			out += "\n\t"
		out += "0x%02x" % bytes[i]
	return out + "\n]\n"

static func _parse_array(text: String, name: String) -> PackedByteArray:
	var m := RegEx.create_from_string("const " + name + ": PackedByteArray = \\[([^\\]]*)\\]").search(text)
	var out := PackedByteArray()
	if m == null:
		return out
	for b in RegEx.create_from_string("0x([0-9a-fA-F]{1,2})").search_all(m.get_string(1)):
		out.append(b.get_string(1).hex_to_int())
	return out
